{
  "name": "review-matters",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:inspect": "prisma db pull --print",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "security:worker": "tsx scripts/security-worker.ts",
    "security:e2e": "tsx scripts/security-e2e.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:smtp": "tsx scripts/check-smtp.ts",
    "panel:check": "tsx scripts/panel-check.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "file-type": "^21.0.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "jsqr": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
