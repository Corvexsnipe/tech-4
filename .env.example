# Do not set DATABASE_URL until the existing database has been inspected.
DATABASE_URL=
APP_URL=http://localhost:3000
# Production must use https://reviewmatters.org
APP_SECRET=
# SMTP is required for verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Absolute directory outside public/. Persist and back up this volume.
UPLOAD_DIR=
# Email of an existing verified account; used only by the bootstrap CLI.
BOOTSTRAP_ADMIN_EMAIL=
# Operations inbox for new support tickets and unassigned owner replies.
SUPPORT_ALERT_EMAIL=
# Comma-separated proxy headers trusted for client-IP detection
# (e.g. "x-forwarded-for" when the app sits behind one trusted proxy, or
# "cf-connecting-ip" behind Cloudflare). Only set headers your proxy actually
# controls — spoofable headers let clients bypass the per-IP review limit.
# cf-connecting-ip is honoured only when CF-RAY is present and the
# X-Forwarded-For chain resolves to the same client — and it is safe only
# when the origin accepts Cloudflare traffic exclusively (firewall rules or
# Cloudflare Tunnel), since the application cannot see the TCP peer.
# When unset, no client header is trusted and the limit cannot be applied.
TRUST_PROXY=

# ---- Anti-VPN / proxy / Tor detection engine ------------------------------
# All values are validated at startup; invalid values fail loudly.
# Master switch. When false, reviews skip network checks but still wait for staff approval.
ANTI_VPN_ENABLED=true
# local = feeds only; hybrid = feeds + external provider when configured.
ANTI_VPN_MODE=hybrid
# true: detection errors keep the review pending and retry with backoff.
# false: detection errors route the review to manual review. Never auto-approves.
ANTI_VPN_FAIL_CLOSED=true
# Optional vendor adapter: none | ipapi-is. Requires ANTI_VPN_EXTERNAL_API_KEY.
ANTI_VPN_EXTERNAL_PROVIDER=none
ANTI_VPN_EXTERNAL_API_KEY=
ANTI_VPN_REQUEST_TIMEOUT_MS=3000
# Vendor verdict cache (per IP hash) — keep within the vendor's licence terms.
ANTI_VPN_CACHE_TTL_SECONDS=3600
# Local dataset older than this cannot clear a review (DATA_STALE).
ANTI_VPN_MAX_DATA_AGE_HOURS=48
# Risk bands (0-100). Must satisfy LOW_MAX < MEDIUM_MAX < HIGH_MIN.
ANTI_VPN_LOW_RISK_MAX=29
ANTI_VPN_MEDIUM_RISK_MAX=69
ANTI_VPN_HIGH_RISK_MIN=70
# Proxy/load-balancer ranges. When set, X-Forwarded-For is walked from the
# proxy side and trusted hops are skipped (clients cannot prepend an address).
ANTI_VPN_TRUSTED_PROXY_CIDRS=
# Dedicated key (>= 32 chars) for IP hashes and at-rest IP encryption.
# Falls back to APP_SECRET (hash version 1) when empty. See rotation notes.
ANTI_VPN_HMAC_SECRET=
ANTI_VPN_FEED_REFRESH_INTERVAL_HOURS=12
# Encrypted IP kept for retries/re-evaluation, then purged.
ANTI_VPN_IP_RETENTION_DAYS=30
# Bounded retries before a failed check becomes a manual-review item.
ANTI_VPN_MAX_RETRIES=8
# How long a submission waits for the inline check before returning "pending".
ANTI_VPN_INLINE_BUDGET_MS=8000
# Run feed refresh / retries / re-evaluation inside the web process every 15
# minutes. Set false when `npm run security:worker` runs from cron instead.
ANTI_VPN_INPROCESS_SCHEDULER=true
